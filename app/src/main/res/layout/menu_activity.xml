<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/g_backround">

    <!-- Centered container -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#d8fffd"
            android:paddingBottom="70dp" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/playText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Play"
                android:padding="10dp"
                android:textColor="#d8fffd"
                android:textSize="30sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_right"
                android:layout_marginBottom="-4dp"/>
        </LinearLayout>

        <!-- Mode options -->
        <LinearLayout
            android:id="@+id/modesContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/btnModeBeginner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beginner (Buttons - Slow)"
                android:textColor="#d8fffd"
                android:textSize="12sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:background="@drawable/bg_mode_button"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/btnModeHard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hard (Buttons - Fast)"
                android:textColor="#d8fffd"
                android:textSize="12sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:background="@drawable/bg_mode_button"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/btnModeTilt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regular (Tilt)"
                android:textColor="#d8fffd"
                android:textSize="12sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:background="@drawable/bg_mode_button"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="120dp" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score"
                android:textColor="#d8fffd"
                android:textSize="30sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnScore"
                android:layout_width="40dp"
                android:layout_height="40dp"

                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_score" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
